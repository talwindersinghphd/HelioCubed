# Total simulation time in seconds
-tstop                           20000000

# CFL Constant
-CFL                             0.6

# Polytropic index
-gamma                           1.6666666666666666666667

# Cells in r, theta, phi directions
-domainSizex                     90
-domainSizey                     90
-domainSizez                     90

# Maximum steps
-maxStep                         3000

# If restart is needed, set restartStep to the step number. Checkpoint file needed
-restartStep                     0

# Output interval of hdf5 files
-outputInterval                  50

# Checkpoint interval
-CheckpointInterval              100

# Maximum number of checkpoint files to keep
-MaxCheckpointFiles              3

# Box size used in domain decomposition
-BoxSize                         45

# Is inner BC set using hdf5 file?
-sph_inner_BC_hdf5               1

# Is limited applied?
-limiter_apply                   1

# Is divergence cleaning applied using Powell's method?
-takedivBstep                    1

# Include solar gravity as an explicit source term?
-Sun_gravity                     1

# Reference frame: 0 = inertial, 1 = co-rotating (fixed BC map longitudes)
# Boundary files and analytic initial velocities are inertial; co-rotating runs
# automatically convert v_phi to v_phi - Omega*r*sin(theta).
-corotating_frame                1

# Sidereal solar rotation period in days (defaults to 25.38 if omitted)
# Used for inertial BC rotation and co-rotating forces/probe transforms.
-solar_rotation_period           25.38

# Time integrator: 1 = Euler, 2 = RK2, 3 = Hancock, 4 = RK4
-timeIntegratorType              3

# Riemann solver type
-Riemann_solver_type             2

# Entropy fix coefficient in Roe solver
-entropy_fix_coeff               0.3

# Are initail conditions set in spherical coordinates?
-initialize_in_spherical_coords  1

# Output vectors in spherical components? Data-file velocities are inertial;
# spatial coordinates remain on the simulation grid.
-output_in_spherical_coords      1    

# Inner radius in AU
-r_in                            0.1   

# Outer radius in AU
-r_out                           1.2

# Strething parameter for dr
-C_rad                           1.0

# BC start time
-BC_start_time                   2024.206170309654

# BC cadence in hours
-BC_cadence                      1.0

# Do supplied BC frames rotate? Used only in the inertial simulation frame.
-BC_frame_rotate                 0

# Probe cadence in seconds
-probe_cadence                   3600  # Seconds

# BC hdf5 file
-BC_file                         ../scripts/psi_eclipse24_swig_wsa2_smth5_bc_r21_5_corotating_Bp_two_frames.h5

# Prefixes for output and Checkpoint files
-Data_file_Prefix                Data_
-Checkpoint_file_Prefix          Checkpoint_

# Probe trajectory file
-Probe_trajectory_file           trajEarth.dat

# Probe output file
-Probe_data_file                 probed_data.dat 

# Create a checkpoint file this many seconds before CME insertion
-CME_get_checkpoint_before       3600

# CME properties
-CME_Enter_Time                  20220.015
-CME_r1                          46.67
-CME_r0                          23.33
-CME_halfangle                   48.00
-CME_pol_flux_control            32.04143
-CME_FRiED_n                     0.40
-CME_lat                         0.00
-CME_lon                         203.82
-CME_tilt                        0.00
-CME_Vandas_R0                   18.17
-CME_apex_speed                  899.97
-CME_energy_control              1.0
-CME_density                     1.38e-23
-CME_helicity_sign               1.00
-CME_a1                          0.00276
-CME_shift                       0.0

# Scaling factors. MHD variables can be scaled using these factors
-density_scale                   700.0
-velocity_scale                  30000000.0

# Turbulence model parameters (used when HelioCubed is compiled with TURB=1)
# Inner-boundary turbulent energy per unit mass, Z^2 [cm^2/s^2]
-Sun_Z2                          3.0e13

# Inner-boundary normalized cross helicity, sigma_c
-Sun_SigmaC                     0.6

# Inner-boundary turbulence correlation length [cm]
-Sun_Lambda                     1.2e9

# Time over which inner-boundary Z^2 ramps to Sun_Z2 [days]
-Scaling_time                   20.0

# Normalized residual energy, sigma_D
-SigmaD                         -0.33333333333333333333

# von Karman--Taylor turbulence constants
-alphaTM                        0.8
-betaTM                         0.4

# Small positive floor used by the turbulence model
-smallTM                        1.0e-8
