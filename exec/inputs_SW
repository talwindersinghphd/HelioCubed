# HelioCubed inputs: File-driven solar wind
# Format: -option value. Keep explanations on separate comment lines.
# Paths are relative to the working directory used to launch the executable.
# Shell geometry is required; other omitted options retain code defaults.

# === Run type and physical model ===

# Initial conditions: 0=file solar wind; 1=analytic solar wind.
# Pulse tests: 2=spherical, 3=spherical with B; 4=off-center, 5=off-center with B.
# Shock tests: 6=spherical hydro, 7=spherical with B.
# Blast tests: 8=off-center hydro, 9=off-center with B; use gamma=1.4 for 8/9.
# Constant Cartesian test fields are set in src/MHD_Constants.H.

# Initial-condition selector; choices are listed above.
-init_condition_type            0
# Perturbation strength for analytic wind and spherical-shock tests.
-strength                       100.
# Ratio of specific heats (dimensionless).
-gamma                          1.5
# Solar gravitational source: 0=off, 1=on.
-Sun_gravity                    1

# === Grid and shell geometry ===

# Cells along each angular direction on each cubed-sphere panel.
-domainSize                     60
# Total radial cells across the shell.
-thickness                      150
# Angular cells per MPI patch; divides domainSize.
-boxSize_nonrad                 30
# Radial cells per MPI patch; divides thickness.
-boxSize_rad                    30
# Inner shell radius (cm).
-inner_radius                   1.4964e12
# Outer shell radius (cm); must exceed inner_radius.
-outer_radius                   1.61124e13
# Radial spacing: 0=uniform, nonzero=exponential stretching.
-radial_stretch                 1.5

# === Spatial scheme and Riemann solver ===

# Solver pairs (spatial_operator, Riemann_solver_type):
# Standard/Rusanov=(1,1), standard/Roe=(1,2), Berta/Rusanov=(2,1), Berta/Roe=(2,2).

# Spatial accuracy: 2=PLM, 4=standard/Berta fourth-order FV.
# At order 2: limiter=0 is unlimited PLM, 1/2=minmod, 3=MC (monotonized central).
# Order 2 uses Cartesian interpolation/reconstruction.
# state_conversion, spatial_operator, Berta and seam-pressure settings apply at order 4.
-spatial_order                  2
# Spatial scheme at order 4: 1=standard FV, 2=Berta WENOZ.
-spatial_operator               1
# Limiter at order 4 (standard scheme): 0=none, 1=fourth-order, 2=minmod.
# At order 2: 0=unlimited, 1/2=minmod, 3=MC. MC requires spatial_order=2.
-limiter                        3
# Riemann solver for either scheme: 1=Rusanov, 2=Roe eight-wave.
-Riemann_solver_type            2
# Roe entropy-fix coefficient: nonnegative; 0 disables the fix.
-entropy_fix_coeff              0.3

# Berta-only settings below; unused by the standard spatial scheme.
# Berta only: 0=Jameson, 1=derivative-ratio detector.
-Berta_detector_type            0
# Berta detector threshold; smaller values trigger more fallback.
-Berta_eta_d                    0.02
# Berta shock reconstruction: 0=WENO3, 1=limited linear (PLM).
-Berta_fallback_type            0

# === Time integration and stopping limits ===

# Time integrator: 1=Euler, 2=SSPRK2, 3=classical RK3, 4=classical RK4.
-temporal_order                 2
# Multiplier of the wave-speed/viscosity timestep estimate.
# Target CFL. After each CME: 20% for 10 minutes, then ramp back over 30 minutes.
-CFL                            1.5
# Maximum step number; stops when this or max_time is reached.
-max_iter                       100000
# Maximum elapsed simulation time (s), including time before a restart.
-max_time                       360000.0
# Calendar start epoch (UTC): decimal year or DD-MM-YYYYTHH:MM:SS.
-BC_start_time                  16-03-2024T12:00:00

# === Divergence control and artificial viscosity ===

# Powell divergence-control source: 0=off, 1=on.
-divergence_cleaning            1
# Artificial viscosity switches are ignored for O2 with minmod or MC (limiter != 0).
# Linear artificial viscosity: 0=off, 1=on.
-linear_viscosity               0
# Nonlinear artificial viscosity: 0=off, 1=on.
-nonlinear_viscosity            0
# Linear artificial-viscosity order: 3 or 5.
-viscosity_order                5
# Viscosity scaling: 0=radius-independent, 1=radius-scaled.
-scale_viscosity_with_r         1
# Pressure-repair cadence; AMR also repairs density and enforces floors at regrids.
-P_floor_cadence                1

# === State conversion and block boundaries ===

# At spatial_order=4, both conversions retain fourth-order averages; Cartesian U does not preserve
# radial symmetry exactly. Optional BC treatments add work and default to off.

# State interpolation at order 4: 0=preserve spherical symmetry, 1=Cartesian U.
-state_conversion               1
# Reconcile fluxes at panel boundaries: 0=off, 1=on.
-boundary_reflux                1
# File BCs: 0=legacy sampling, 1=centered sampling/conserved averages.
-BC_conserved_averages          1
# Angular ghost energy correction to interpolated pressure: 0=off, 1=on. Not used for O2.
-seam_pressure_correction       1
# Legacy interpolation selector (0/1); unused by the current driver.
-MBInterp_define                1

# === Adaptive mesh refinement (AMR) ===

# 0=single level; N allows fine levels L1,...,LN. Requires PR_AMR.
# O2: RK2/3. O4: RK3/4, state_conversion=1, domainSize>=20.
# AMR needs boundary_reflux=1.
-amr_max_level                  0
# One ratio for all interfaces, or a list such as 2,4,8; 1 leaves a direction alone.
-amr_ref_ratio_rad              2
-amr_ref_ratio_nonrad           1
# Fine patch cell counts: 0=automatic; one value or one per fine level.
-amr_boxSize_rad                0
-amr_boxSize_nonrad             0
-amr_subcycling                 0
-amr_verbosity                  0
# Regrid by base steps or simulation seconds (0 disables each); buffer is in parent cells.
-amr_regrid_interval            1000000
-amr_regrid_time_cadence        3600
-amr_buffer                     2
# Convergence compares conservative composite projections; convTestType=1/2
# runs three AMR meshes. convergence_level=0/1/2 runs one; 3 compares saved runs.

# Any criterion can tag: MS-FLUKSS relative gradient of rho, p, |B| or |v|.
# Negative disables; zero tags nonzero gradients. Omitted rho/p use amr_threshold.
-amr_refine_density_thresh      -1
-amr_refine_pressure_thresh     -1
-amr_refine_B_thresh            -1
-amr_refine_V_thresh            0.2
# Finest child level per criterion: -1=amr_max_level, 0=disabled.
-amr_refine_density_maxlevel    -1
-amr_refine_pressure_maxlevel   -1
-amr_refine_B_maxlevel          -1
-amr_refine_V_maxlevel          -1
# Optional tag regions (union): r in cm; angles in degrees; longitude may wrap 0.
#-amr_refine_r_range.0           1.4964e12,1.61124e13
#-amr_refine_colat_range.0       60,120
#-amr_refine_lon_range.0         350,20
#-amr_refine_r_range.1           1.4964e12,1.61124e13
#-amr_refine_colat_range.1       60,120
#-amr_refine_lon_range.1         170,200
# Optional regions: [level,]block,lo_r,lo_j,lo_k,hi_r,hi_j,hi_k (parent cells).
#-amr_refine_regions            1,5,4,4,4,7,7,7
# AMR output: *_amr_<step>.hdf5 + .map.hdf5; restart from *_amr_<step>.amr.

# === Convergence controls ===

# Other modes: convTestType=3 compares initial states; 4 initializes one grid only.
# convergence_level and convergence_dt apply to convergence modes 1/2.

# Mode: 0=simulation, 1=space convergence, 2=space/time convergence.
-convTestType                   0
# Convergence refinement: 0=all directions, 1=radial direction only.
-radial_refinement              0

# === Solar-wind file boundary data ===

# File boundary controls apply to init_condition_type=0.

# Solar-wind boundary HDF5 file; used by init_condition_type=0.
-BC_file                        ../scripts/psi_eclipse24_swig_wsa2_smth5_bc_r21_5_corotating_Bp_two_frames.h5
# Time between successive boundary frames (hours).
-BC_cadence                     1.0
# Apply solar rotation to boundary frames: 0=off, 1=on.
-BC_frame_rotate                0
# Frame selection: 0=use all available frames, 1=use only the first.
-BC_force_single_frame          0

# === Volume and slice output ===

# Step/time triggers are combined; final output is always written.
# Volume output is also written immediately after a scheduled CME insertion.
# Use large positive cadences to suppress periodic output.

# Prefix for volume and slice output filenames.
-data_file_prefix               data
# Full-volume HDF5 output every this many steps.
-write_cadence                  100000
# Full-volume HDF5 output interval in elapsed simulation time (s).
-write_time_cadence             10800
# Slice output every this many steps.
-slice_cadence                  200000
# Slice output interval in elapsed simulation time (s).
-slice_time_cadence             10800
# Slice selection: any combination of X, Y, Z (planes) and R (shell).
-slices                        X Y Z R
# Volume/slice vector components: 0=spherical, 1=Cartesian.
-output_coordinates            0
# Output: 0=unscaled CGS, 1=radius scaling and presentation units.
-scale_data_with_r              1
# Append physical div(B) to volume output: 0=no, 1=yes.
-output_divB                    1

# === Checkpointing and restart ===

# Checkpoint filename prefix.
-checkpoint_file_prefix         checkpoint
# Save a restart checkpoint every this many steps.
-checkpoint_cadence             100
# Number of recent checkpoints targeted for retention.
-max_checkpoint_files           3
# Uncomment to resume from this checkpoint instead of initializing.
#-restart_file                  checkpoint_amr_600.amr

# === Trajectory probes ===

# Number of trajectory probes; 0 disables probes (up to 32 named entries).
-num_probes                     1
# Trajectory-probe sampling interval (s).
-Probe_cadence                  3600
# Trajectory file: year, day-of-year, radius (AU), HGI latitude/longitude (deg).
-probe0.coords                  trajEarth
-probe0.filename                Earth.dat
#-probe1.coords                  traj_0
#-probe1.filename                Probe_0.dat

# === GCS CMEs ===

# Example fit; replace these values with measurements for the event.
# Set num_CMEs=0 for solar wind only. Repeat CME1.*, CME2.*, ... for more events.
# Checkpoints retain insertion state to prevent duplicate CMEs on restart.
-num_CMEs                       1
# CME geometry: 0=disabled, 1=regular normal-section FRiED (default), 2=GCS with smooth joins.
# Both use the same GCS/DBM/flux inputs. Type 2 preserves the fitted aspect ratio.
# Type 2 rejects overlapping sections instead of adjusting the geometry.
-CME0.CME_type                  1
# Injection: volume (default) with boundary leg feeding, or experimental boundary emergence.
# Boundary prescribes the analytic field by superposition; sub-fast inflow is diagnosed.
-CME0.CME_injection_method      volume
# Smoothly fade boundary B, added density and excess velocity to WSA over this
# many seconds after insertion (default 43200 = 12 hours). 0 disables volume leg feeding.
-CME0.CME_boundary_taper_time    43200
# GCS leading-edge speed (km/s), final fitted height (solar radii), and UTC epoch.
-CME0.GCS_speed                  900
-CME0.GCS_fit_height             15
-CME0.GCS_fit_time               17-03-2024T12:00:00
# GCS latitude, Stonyhurst longitude, tilt, half angle (degrees), and aspect ratio.
-CME0.GCS_latitude               0
-CME0.GCS_longitude              0
-CME0.GCS_tilt                   0
-CME0.GCS_half_angle             40
-CME0.GCS_aspect_ratio           0.5
# DBM drag (km^-1), ambient wind (km/s), and reference leading height (solar radii).
-CME0.DBM_gamma                  1e-8
-CME0.DBM_wind_speed             450
-CME0.DBM_target_height          70
# Positive measured fluxes (Mx); negative or omitted values use empirical estimates.
-CME0.CME_poloidal_flux          -1
-CME0.CME_toroidal_flux          -1
-CME0.CME_leading_polarity       1
-CME0.CME_helicity_sign          1
# Minimum added density [g/cm^3]. Loading automatically increases it where needed
# to keep the initial/inflow Alfven speed <= four times the local radial driver speed.
-CME0.CME_density                1.38e-23
# Optional added pressure / rope magnetic pressure; default 0 preserves ambient temperature.
# -CME0.CME_plasma_beta          0
# Earth trajectory for the Stonyhurst-to-simulation longitude conversion.
-CME0.GCS_earth_trajectory       trajEarth
